# Allow NFC service to be found
allow platform_app nfc_service:service_manager find;

# ExpressiveOS HALs (SystemUIGoogle/HealthService + PowerShareTile + Touch)
hal_client_domain(platform_app, hal_eos_health)
hal_client_domain(platform_app, hal_eos_powershare)
hal_client_domain(platform_app, hal_eos_touch)

# External storage & shutter sound
allow platform_app mnt_pass_through_file:dir { create_dir_perms mounton };
get_prop(platform_app, audio_config_prop)

# Launcher & SystemUI telemetry
r_dir_file(platform_app, config_gz)
r_dir_file(platform_app, sysfs_zram)
get_prop(platform_app, bluetooth_lea_prop)
r_dir_file(platform_app, sysfs_thermal)

# Incremental File System signature/block inspection
allowxperm platform_app apk_data_file:file ioctl {
  INCFS_IOCTL_READ_SIGNATURE
  INCFS_IOCTL_FILL_BLOCKS
  INCFS_IOCTL_GET_BLOCK_COUNT
  INCFS_IOCTL_GET_FILLED_BLOCKS
};

allow platform_app proc_filesystems:file r_file_perms;
get_prop(platform_app, incremental_prop)
get_prop(platform_app, pm_archiving_enabled_prop)

allow platform_app sysfs_zram:dir r_dir_perms;
allow platform_app sysfs_zram:file r_file_perms;

# Boot animation & Columbus
allow platform_app bootanim_system_prop:property_service set;
allow platform_app system_prop:property_service set;

# Sandbox
allow platform_app ax_sandbox_service:service_manager find;
allow platform_app ax_sandbox_vault_file:dir create_dir_perms;
allow platform_app ax_sandbox_vault_file:file create_file_perms;
allow platform_app system_data_file:dir r_dir_perms;
allow platform_app system_data_file:file r_file_perms;
allow platform_app system_userdir_file:dir r_dir_perms;
allow platform_app system_userdir_file:file r_file_perms;
