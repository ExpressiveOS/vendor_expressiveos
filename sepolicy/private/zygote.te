# Zygote evaluates android:requiredSystemPropertyName on static framework overlays
# (e.g. ExpressiveLauncherPixelModeOverlay -> persist.sys.expressiveos.launcher)
# during createImmutableFrameworkIdmapsInZygote().
get_prop(zygote, eos_system_prop)
